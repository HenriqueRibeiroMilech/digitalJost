# Modelo de nomes; este arquivo não é carregado pela aplicação.
# Cadastre os valores no ambiente dos processos, conforme:
# docs/configuracao-externa-td-sessao.md
# Não preencha nem versione valores reais neste arquivo.

# Conexão ODBC completa já utilizada pelo TD, mantendo as credenciais atuais.
DJ_TD_ODBC_CONNECTION_STRING=

# Valor atual da SECRET_KEY do Flask, para preservar a assinatura das sessões.
DJ_SESSION_SECRET_KEY=
