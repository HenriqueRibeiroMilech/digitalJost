# MODELO SEM VALORES. Preencher somente um arquivo privado ou o ambiente Windows.
# CONFIGURACAO PRIVADA: nao versionar valores nem publicar o arquivo no webroot.
# Ambiente Windows tem prioridade; nomes/grupos sao organizacao, nao ativacao.
# No servidor: arquivo fora da pasta publicada, selecionado por DJ_ENV_FILE.
# No Flask CLI: definir FLASK_SKIP_DOTENV=1 no ambiente antes de iniciar.
# Guia: handbook/docs/servidor-e-publicacao.md

# A) COMPARTILHADO: JA UTILIZADO PELA ARQUITETURA NOVA E PELO LEGADO
# TD geral: mesmo banco corporativo para Eventos/proximos modulos e para app/.
# Cada arquitetura mantem seus proprios engines/pools; nao ha conexao por feature.
DJ_TD_ODBC_CONNECTION_STRING=

# Sessao Flask compartilhada: assina os cookies do portal, inclusive as telas Vue.
# Esta chave continua configurada na factory app/config.py; manter o valor atual.
DJ_SESSION_SECRET_KEY=

# LDAP compartilhado: a mesma conta privada atende o legado e a nova consulta de
# nome/setor nas presencas. Clientes/conexoes continuam separados por arquitetura.
DJ_LDAP_USER=
DJ_LDAP_PASSWORD=

# Opcionais do cliente moderno: se ausentes, usa o host/base do LDAP legado,
# porta 389, sem SSL, e timeout de 2 segundos para conexao/recebimento.
# Para LDAPS validado: DJ_LDAP_USE_SSL=true, porta padrao 636 e CA confiavel no SO.
# Definir somente no arquivo privado ou ambiente, quando necessario:
# DJ_LDAP_HOST, DJ_LDAP_SEARCH_BASE, DJ_LDAP_PORT, DJ_LDAP_USE_SSL,
# DJ_LDAP_CONNECT_TIMEOUT, DJ_LDAP_RECEIVE_TIMEOUT.

# B) LEGADO ATIVO: INTEGRACOES IMPLEMENTADAS EM app/
# A aplicacao ainda carrega esse legado. Login/erros globais podem afetar o Vue.
# FTM: dados industriais/FT Metrics. Plex: dados Plex/linked server.
# Trace QR: rastreabilidade de montagem. Sao conexoes ODBC completas.
DJ_FTM_ODBC_CONNECTION_STRING=
DJ_PLEX_ODBC_CONNECTION_STRING=
DJ_TRACE_QR_ODBC_CONNECTION_STRING=

# MES: usuario/senha usados na integracao de alteracao de paradas.
DJ_MES_USER=
DJ_MES_PASSWORD=

# Microsoft/Teams: tenant e aplicativo, segredo do aplicativo e conta atual de usuario.
# Utilizados pelo gerenciador de tokens legado, Teams e rotinas de usuarios.
# Erros globais do Flask podem usar essa integracao, inclusive em rotas modernas.
DJ_MICROSOFT_TENANT_ID=
DJ_MICROSOFT_CLIENT_ID=
DJ_MICROSOFT_CLIENT_SECRET=
DJ_MICROSOFT_USERNAME=
DJ_MICROSOFT_PASSWORD=

# SAP: usuario/senha da conexao SOAP dos relatorios de manutencao.
DJ_SAP_USER=
DJ_SAP_PASSWORD=

# C) LEGADO SEM CONSUMIDOR ATIVO CONFIRMADO OU COM MODULO DESATIVADO
# Plex de teste: nenhuma utilizacao alem da constante CNNX_PLEX_TEST foi encontrada.
# Continua obrigatorio no import de constants.py; nao remover nesta etapa.
DJ_PLEX_TEST_ODBC_CONNECTION_STRING=

# Oracle: usuario/senha referenciados em horas produtivas (productiveHours.py).
# Esse blueprint continua desativado; estes valores nao ativam a funcionalidade.
DJ_ORACLE_USER=
DJ_ORACLE_PASSWORD=
