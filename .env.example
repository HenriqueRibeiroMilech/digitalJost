# Modelo sem valores. A aplicação lê .env na raiz ou o arquivo absoluto DJ_ENV_FILE.
# O ambiente do Windows tem prioridade. Não preencha este modelo com valores reais.
# Guia: docs/configuracao-privada-integracoes.md
# No Flask CLI, defina FLASK_SKIP_DOTENV=1 no ambiente antes de iniciar o processo.

# Conexão ODBC completa já utilizada pelo TD, mantendo as credenciais atuais.
DJ_TD_ODBC_CONNECTION_STRING=

# Valor atual da SECRET_KEY do Flask, para preservar a assinatura das sessões.
DJ_SESSION_SECRET_KEY=

# Outros bancos legados (conexões ODBC completas, preservando suas opções).
DJ_FTM_ODBC_CONNECTION_STRING=
DJ_PLEX_ODBC_CONNECTION_STRING=
DJ_PLEX_TEST_ODBC_CONNECTION_STRING=
DJ_TRACE_QR_ODBC_CONNECTION_STRING=

# Integração MES.
DJ_MES_USER=
DJ_MES_PASSWORD=

# Consulta LDAP: login, usuários externos, H24 e módulo temporário desativado.
DJ_LDAP_USER=
DJ_LDAP_PASSWORD=

# Microsoft/Teams: identidade de aplicação e conta utilizadas atualmente.
DJ_MICROSOFT_TENANT_ID=
DJ_MICROSOFT_CLIENT_ID=
DJ_MICROSOFT_CLIENT_SECRET=
DJ_MICROSOFT_USERNAME=
DJ_MICROSOFT_PASSWORD=

# SAP: relatórios de manutenção.
DJ_SAP_USER=
DJ_SAP_PASSWORD=

# Oracle: código de horas produtivas que continua desativado.
DJ_ORACLE_USER=
DJ_ORACLE_PASSWORD=
