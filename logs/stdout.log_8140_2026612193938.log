                FROM Mach_2_OEE_v2 T1 
                    JOIN Mach_2_OEE_Cavity_Info T2 ON T1.id = T2.id_Mach_2_OEE_v2
                    LEFT JOIN OPENQUERY([PLEX_DSN_JOST], '
                        SELECT
                            T3.Workcenter_Code
                            , T3.Name
                            , T2.Crew_Size
                            , T1.Part_No
                        FROM
                            Part_v_Part T1
                            JOIN Part_v_Approved_Workcenter T2 ON T1.Part_Key = T2.Part_Key
