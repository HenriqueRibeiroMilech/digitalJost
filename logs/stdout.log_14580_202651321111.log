            T1.record_time BETWEEN ? AND ?
            AND T2.Workcenter_Key IN (?)
            AND T1.workcenter_shift IN (?, ?, ?, ?)

        GROUP BY FORMAT(record_time, 'dd/MM') 

        ORDER BY MIN(T1.record_time)]
