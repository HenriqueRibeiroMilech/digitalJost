                        ') T02 ON T01.part = T02.Part_No COLLATE SQL_Latin1_General_CP1_CI_AS

                    GROUP BY T01.id_Mach_2_OEE_v2
                )

                SELECT
                    FORMAT(record_time, 'dd/MM') AS Time_Group
