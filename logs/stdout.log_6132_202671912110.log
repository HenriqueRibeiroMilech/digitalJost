                    CASE WHEN T1.workcenter_shift = 'Primeiro' THEN '1' WHEN T1.workcenter_shift = 'Segundo' THEN '2' WHEN T1.workcenter_shift = 'Terceiro' THEN '3' ELSE 'Extra' END AS shift
                    , NULLIF(T2.job, 'N/A') AS job
