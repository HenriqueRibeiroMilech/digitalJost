                WHERE t1.record_time > @record_time AND t1.workcenter = @workcenter_filter
            )

            SELECT TOP 5   
                Event AS reason
                , CAST(SUM(Log_Duration) / 60.0 AS INT) AS [time]
            FROM (
                SELECT * FROM main_events
                UNION ALL
                SELECT * FROM invade_time
            ) all_events
            WHERE Status NOT IN ('Produção', 'Programada')
            GROUP BY Event
            ORDER BY [time] DESC
        ]
