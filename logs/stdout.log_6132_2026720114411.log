                        WHERE T1.Revision = ''SAP'' AND T4.Active = 1 AND T3.Workcenter_Code = ''M07''
                    ') T3 ON 
                        T1.workcenter = T3.Workcenter_Code COLLATE SQL_Latin1_General_CP1_CI_AS AND
                        T2.part = T3.Part_No COLLATE SQL_Latin1_General_CP1_CI_AS

                WHERE T1.workcenter = ?

