                FROM Mach_2_Status_Reason_Time
                WHERE record_time < @record_time AND workcenter = @workcenter_filter
            ),
            invade_time AS (
                SELECT
                    COALESCE(plex.Workcenter_Event_Group, 'Produção') AS Status,
