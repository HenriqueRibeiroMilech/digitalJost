                WITH target_rates AS (

                    SELECT 
                        T01.id_Mach_2_OEE_v2
                        , AVG(T02.Target_Rate) as Target_Rate
                    FROM

                        Mach_2_OEE_Cavity_Info T01 

                        JOIN OPENQUERY([PLEX_DSN_JOST], '
                            SELECT 
                                T1.Part_No
                                , T2.Target_Rate
