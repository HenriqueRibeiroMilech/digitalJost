<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <handlers>
            <add name="Python Interpreter" path="*.py" verb="*" modules="CgiModule" scriptProcessor="I:\IIS\Digital_Jost\.venv\Scripts\python.exe %s %s" resourceType="File" requireAccess="Script" />
            <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" requireAccess="Script" />
        </handlers>

        <httpPlatform stdoutLogEnabled="true" stdoutLogFile="I:\IIS\Digital_Jost\logs\stdout.log" startupTimeLimit="100" startupRetryCount="1" forwardWindowsAuthToken="true" processPath="I:\IIS\Digital_Jost\.venv\Scripts\python.exe" arguments="-m flask run --port %HTTP_PLATFORM_PORT%">
            <environmentVariables>
                <environmentVariable name="FLASK_SKIP_DOTENV" value="1" />
                <environmentVariable name="FLASK_APP" value="I:\IIS\Digital_Jost\main.py" />
            </environmentVariables>
        </httpPlatform>
        <security>
            <authorization>
                <remove users="*" roles="" verbs="" />
                <add accessType="Allow" users="*" />
                <add accessType="Allow" roles="GRP_IIS_DigitalJost" />
                <add accessType="Allow" roles="GRP_IIS_DigitalJost_Fabrica" />
            </authorization>
            <requestFiltering>
                <requestLimits maxAllowedContentLength="209715200" /> <!-- 200 MB -->
            </requestFiltering>
        </security>
    </system.webServer>
</configuration>